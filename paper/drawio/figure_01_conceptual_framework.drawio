        <mxCell id="b_prob" value="&lt;b&gt;PROBLEM STATEMENT&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Unregulated terminal queue congestion&lt;br&gt;• Passenger queue anxiety &amp;amp; unfair cutting&lt;br&gt;• Arbitrary fare charging without standard tariff&lt;br&gt;• Inefficient manual paper dispatching at terminal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Times New Roman,Arial;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="40" y="80" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="b_input" value="&lt;b&gt;INPUT REQUIREMENTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;• HTML5 Geolocation API (W3C Standard)&lt;br&gt;• 35m Terminal Geofence (15.4247°N, 120.9416°E)&lt;br&gt;• Municipal MTOP Franchising Guidelines&lt;br&gt;• ISO/IEC 25010:2023 System Quality Model &amp;amp; TAM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Times New Roman,Arial;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="800" y="80" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="b_proc" value="&lt;b&gt;PROCESS: 7-PHASE AGILE SDLC ENGINE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Phase 1: Planning &amp;amp; Feasibility • Phase 2: Requirements Analysis&lt;br&gt;Phase 3: Architecture &amp;amp; DB Design • Phase 4: Full-Stack Implementation&lt;br&gt;Phase 5: Verification &amp;amp; Spatial Testing • Phase 6: Field Deployment&lt;br&gt;Phase 7: ISO 25010 &amp;amp; TAM Empirical Evaluation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Times New Roman,Arial;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="220" y="310" width="700" height="210" as="geometry" />
        </mxCell>
        <mxCell id="b_out" value="&lt;b&gt;OUTPUT: DEPLOYED SRH LINK-TODA PWA PLATFORM&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Commuter PWA (Live standby queue display &amp;amp; metered fare booking)&lt;br&gt;• Driver Terminal PWA (35m GPS duty check-in &amp;amp; Priority Recovery Engine)&lt;br&gt;• TODA Dispatcher &amp;amp; Superadmin Hub (Queue oversight &amp;amp; audit trails)&lt;br&gt;• Validated Quality: ISO 25010 Mean: 4.88 | TAM Rating: 4.86" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Times New Roman,Arial;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="170" y="570" width="800" height="140" as="geometry" />
        </mxCell>
