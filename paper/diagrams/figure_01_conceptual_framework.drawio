        <mxCell id="c_input" value="&lt;b&gt;INPUT (REQUIREMENTS &amp;amp; STANDARDS)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Unregulated Manual Queue &amp;amp; Commuter Anxiety&lt;br&gt;• HTML5 GPS &amp;amp; 35m Geofence Anchor (15.4247°N, 120.9416°E)&lt;br&gt;• Municipal MTOP &amp;amp; Driver LTO Credentials&lt;br&gt;• ISO/IEC 25010:2023 &amp;amp; WCAG 2.2 Standards&lt;br&gt;• Technology Acceptance Model (TAM: PEOU &amp;amp; PU)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;fontSize=11;" vertex="1" parent="1">
